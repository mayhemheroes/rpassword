project: rpassword
# Ported from the fork's mayhem/fuzz_password_input.mayhemfile. The old target was a black-box
# (libfuzzer: false) file-input binary; this is now the instrumented libfuzzer-sys harness from the
# additive mayhem/fuzz/ crate, so the run gets coverage edges instead of black-box stabs.
target: fuzz-password-input

cmds:
  # libFuzzer target: Mayhem drives inputs through the libFuzzer entrypoint, so NO '@@'
  # (Mayhem rejects '@@' on a libfuzzer:true target).
  - cmd: /mayhem/fuzz_password_input
    libfuzzer: true
